+"""Default only reads available models. --chat explicitly sends one billed chat request."""
+import argparse
+import json
+import os
+import urllib.request
+import urllib.error
+from pathlib import Path
+
+p=argparse.ArgumentParser(description="Kiểm tra khóa DeepSeek, không in khóa")
+p.add_argument("--chat", action="store_true", help="Gửi một lời chào thật, có thể tính phí token")
+args=p.parse_args()
+# Read the simple KEY=VALUE file generated by setup.py; environment takes precedence.
+env=Path(__file__).resolve().parents[2]/".env"
+if env.is_file():
+    for line in env.read_text(encoding="utf-8").splitlines():
+        if line and not line.lstrip().startswith('#') and '=' in line:
+            key,value=line.split('=',1)
+            os.environ.setdefault(key.strip(),value.strip().strip('"').strip("'"))
+key=os.environ.get("DEEPSEEK_API_KEY", "")
+if not key:
+    raise SystemExit("Chưa đặt DEEPSEEK_API_KEY trong .env hoặc biến môi trường.")
+headers={"Authorization":"Bearer "+key,"Content-Type":"application/json"}
+if args.chat:
+    data=json.dumps({"model":os.environ.get("DEEPSEEK_MODEL","deepseek-flash"),
+        "messages":[{"role":"user","content":"Trả lời một câu chào bằng tiếng Việt."}],
+        "thinking":{"type":"disabled"},"max_tokens":64,"stream":False}).encode()
+    req=urllib.request.Request("https://api.deepseek.com/chat/completions",headers=headers,data=data)
+else:
+    req=urllib.request.Request("https://api.deepseek.com/models",headers=headers)
+try:
+    with urllib.request.urlopen(req,timeout=60) as r:
+        body=json.load(r)
+    if args.chat:
+        print(body['choices'][0]['message']['content'])
+        print("Token đã dùng:",body.get('usage',{}))
+    else:
+        print("Khóa được chấp nhận. Các model:",', '.join(m['id'] for m in body.get('data',[])))
+except urllib.error.HTTPError as e:
+    tips={401:"Khóa không hợp lệ.",402:"Không đủ số dư: vào trang Top up.",429:"Đang vượt giới hạn: đợi rồi thử lại."}
+    raise SystemExit(f"HTTP {e.code}: "+tips.get(e.code,"Kiểm tra trạng thái dịch vụ và cấu hình model."))
+except urllib.error.URLError:
+    raise SystemExit("Không kết nối được DeepSeek. Kiểm tra mạng, DNS hoặc proxy.")
