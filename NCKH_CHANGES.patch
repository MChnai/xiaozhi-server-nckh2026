+"""Run from anywhere: python deploy/nckh/setup.py --host 192.168.1.19"""
+import argparse
+import ipaddress
+import secrets
+from pathlib import Path
+
+root = Path(__file__).resolve().parents[2]
+p = argparse.ArgumentParser(description="Tạo cấu hình Robot AI tiếng Việt")
+p.add_argument("--host", required=True, help="IPv4 LAN của máy chạy Docker")
+args = p.parse_args()
+ip = ipaddress.IPv4Address(args.host)
+if ip.is_loopback or ip.is_unspecified or ip.is_multicast:
+    p.error("Dùng IPv4 LAN truy cập được từ robot")
+env = root / ".env"
+if env.exists():
+    raise SystemExit("Đã có .env. Giữ nguyên mật khẩu hiện tại; sửa NCKH_PUBLIC_HOST trong tệp khi đổi IP.")
+text = (root / "deploy/nckh/.env.example").read_text(encoding="utf-8")
+text = text.replace("NCKH_PUBLIC_HOST=192.168.1.19", "NCKH_PUBLIC_HOST=" + str(ip))
+for name in ("MYSQL_ROOT_PASSWORD", "MYSQL_PASSWORD", "NCKH_SERVER_SECRET"):
+    text = text.replace(name + "=\n", name + "=" + secrets.token_hex(24) + "\n")
+env.write_text(text, encoding="utf-8")
+env.chmod(0o600)
+print("Đã tạo .env. Chế độ demo không cần khóa DeepSeek.")
