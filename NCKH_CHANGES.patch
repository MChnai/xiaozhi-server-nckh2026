+"""Connectivity checks only: no registration, pairing, cloud call or motor action."""
+import argparse
+import urllib.request
+import urllib.error
+
+p=argparse.ArgumentParser(description="Kiểm tra cổng web, OTA và WebSocket")
+p.add_argument("--host", default="127.0.0.1", help="IP của máy chủ")
+args=p.parse_args()
+checks=[(8002,"/healthz", "Web"),(8002,"/nckhsv/ota/", "OTA tương thích firmware"),(8002,"/xiaozhi/ota/", "OTA gốc"),(8000,"/", "Cổng WebSocket (HTTP health)")]
+failures=0
+for port,path,label in checks:
+    try:
+        with urllib.request.urlopen(f"http://{args.host}:{port}{path}",timeout=10) as r:
+            body=r.read(4096).decode("utf-8")
+            if path.endswith('/ota/') and "bình thường" not in body:
+                raise ValueError(body)
+            print(f"[ĐẠT] {label}: HTTP {r.status} — {body.strip()}")
+    except Exception as exc:
+        failures+=1
+        print(f"[LỖI] {label}: {exc}")
+raise SystemExit(1 if failures else 0)
