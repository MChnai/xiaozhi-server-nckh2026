+    except ValueError as e:
+        return ActionResponse(Action.REQLLM, str(e))
+    except Exception:
+        return ActionResponse(Action.REQLLM, "Không lưu được lời nhắc. Kiểm tra MySQL và cấu hình bộ nhắc nhở.")
