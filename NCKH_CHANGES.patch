+"""Download once from VinAI and convert on CPU. Existing model is kept intact on failure."""
+import os
+import shutil
+from pathlib import Path
+from ctranslate2.converters import TransformersConverter
+
+out = Path("/models/phowhisper-small-ct2")
+if (out / "model.bin").is_file():
+    print("Đã có PhoWhisper CT2; không tải lại.")
+else:
+    staging = Path("/models/phowhisper-small-ct2.build")
+    if staging.exists():
+        shutil.rmtree(staging)
+    converter = TransformersConverter("vinai/PhoWhisper-small",
+        revision=os.environ.get("PHOWHISPER_REVISION", "main"),
+        copy_files=["tokenizer.json", "preprocessor_config.json"])
+    converter.convert(str(staging), quantization="int8")
+    if out.exists():
+        out.rmdir()  # Only remove an empty placeholder, never replace an existing model.
+    staging.rename(out)
+    print("Đã chuẩn bị PhoWhisper-small CT2 int8.")
