FROM python:3.11-slim
ENV DO_NOT_TRACK=1 HF_HUB_DISABLE_TELEMETRY=1 ORT_DISABLE_TELEMETRY=1
ARG TTS_ENGINE=piper
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 espeak-ng ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir --upgrade pip \
    && if [ "$TTS_ENGINE" = "piper" ]; then python -m pip install --no-cache-dir piper-tts==1.8.0; \
       elif [ "$TTS_ENGINE" = "vieneu" ]; then python -m pip install --no-cache-dir vieneu==3.8.3; \
       else exit 1; fi
COPY deploy/nckh/offline_tts_server.py /opt/offline_tts_server.py
ENV HF_HOME=/models/huggingface HF_HUB_DISABLE_TELEMETRY=1
EXPOSE 5100
CMD ["python", "-u", "/opt/offline_tts_server.py"]

