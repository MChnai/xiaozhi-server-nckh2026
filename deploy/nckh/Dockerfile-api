FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY main/manager-api/pom.xml ./
COPY main/manager-api/src ./src
RUN mvn -B package -DskipTests
FROM eclipse-temurin:21-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends curl fontconfig fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /src/target/xiaozhi-esp32-api.jar ./api.jar
ENV TZ=Asia/Ho_Chi_Minh
EXPOSE 8003
ENTRYPOINT ["java", "-Duser.language=vi", "-Duser.country=VN", "-jar", "/app/api.jar"]
